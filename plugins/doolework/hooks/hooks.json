{
  "description": "Inject antislop rules at session start and after /clear or compaction",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/rules.md\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
