{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Users\\Dayle Frost\\.hindsight\\coding-agents\\dist\\claude-sessionstart-hook.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Users\\Dayle Frost\\.hindsight\\coding-agents\\dist\\claude-hook.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Users\\Dayle Frost\\.hindsight\\coding-agents\\dist\\claude-stop-hook.js\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47821/hook/<token>/ask",
            "timeout": 600
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47821/hook/<token>/permission",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -Command \"& 'E:\\REPOS\\PROGRAMS\\Notifi\\target\\debug\\notifi.exe' --claude-statusline\""
  },
  "permissions": {
    "deny": [
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Drive"
    ]
  },
  "enabledPlugins": {
    "doolework@doole": true
  },
  "extraKnownMarketplaces": {},
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
